{
  "name": "starter-monorepo-microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:all": "nest build api && nest build transactions-processor && nest build cache-warmer && nest build queue-worker && nest build common",
    "build:infra": "npm run build:all && npm run copy-config-infra",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run copy-config && npm run nest-start",
    "start:api": "cross-env NODE_APP=api npm run start",
    "start:cache-warmer": "cross-env NODE_APP=cache-warmer npm run start",
    "start:queue-worker": "cross-env NODE_APP=queue-worker npm run start",
    "start:transactions-processor": "cross-env NODE_APP=transactions-processor npm run start",
    "copy-config-infra": "mkdir -p dist/config && cp config/config.yaml dist/config/config.yaml && cp config/schema.yaml dist/config/schema.yaml",
    "copy-config": "mkdir -p ./apps/$NODE_APP/config && cp ./config/config.yaml ./apps/$NODE_APP/config/config.yaml && cp ./config/schema.yaml ./apps/$NODE_APP/config/schema.yaml && mkdir -p dist/config && cp ./config/config.yaml dist/config/config.yaml && cp ./config/schema.yaml dist/config/schema.yaml",
    "nest-start": "node $( [ \"$NODE_WATCH\" = \"true\" ] && echo \"--watch\" ) dist/apps/$NODE_APP/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./test/unit/jest.config.js",
    "test:watch": "jest --config ./test/unit/jest.config.js --watch",
    "test:cov": "jest --config ./test/unit/jest.config.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json",
    "test:performance": "k6 run -e BASE_URL=http://localhost:3000 test/performance/load-test.js",
    "generate-types": "mxnest schema types config/schema.yaml libs/common/src/entities/config.d.ts",
    "audit:security": "npm audit --production --audit-level=high"
  },
  "dependencies": {
    "@multiversx/sdk-core": "13.2.1",
    "@multiversx/sdk-nestjs-auth": "^7.0.1",
    "@multiversx/sdk-nestjs-cache": "^7.0.1",
    "@multiversx/sdk-nestjs-cli": "1.0.2",
    "@multiversx/sdk-nestjs-common": "^7.0.1",
    "@multiversx/sdk-nestjs-elastic": "^7.0.1",
    "@multiversx/sdk-nestjs-http": "^7.0.1",
    "@multiversx/sdk-nestjs-monitoring": "3.7.7",
    "@multiversx/sdk-nestjs-rabbitmq": "^7.0.1",
    "@multiversx/sdk-nestjs-redis": "3.7.7",
    "@multiversx/sdk-network-providers": "^2.9.3",
    "@multiversx/sdk-transaction-processor": "0.1.33",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/microservices": "^11.1.23",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/platform-socket.io": "^11.1.23",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.23",
    "bull": "^4.16.5",
    "cache-manager": "^5.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "=1.8.1",
    "cookie-parser": "^1.4.6",
    "cron": "^3.1.6",
    "dotenv": "^17.4.2",
    "express-rate-limit": "=8.5.1",
    "helmet": "=8.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "module-alias": "^2.2.3",
    "mysql2": "^3.22.3",
    "nest-winston": "^1.9.2",
    "prom-client": "^14.2.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^4.6.3",
    "typeorm": "^1.0.0",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@types/cache-manager": "^4.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.1",
    "@types/js-yaml": "^4.0.5",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.1.4",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "js-yaml": "^4.1.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.11",
    "ts-loader": "9.4.2",
    "ts-node": "10.7.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  },
  "_moduleAliases": {
    "@libs/common": "dist/libs/common"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "apps",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@libs/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@libs/common": "<rootDir>/libs/common"
    }
  },
  "overrides": {
    "uuid": "^11.1.1",
    "lodash": "^4.17.21",
    "file-type": "^21.3.4",
    "qs": "^6.14.0"
  }
}
