# ===============================================================================
# Environment Configuration for MultiversX Assets CDN & Core Template
# ===============================================================================

# GitHub Token (for private repository access)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# CORS Configuration
ALLOWED_ORIGIN=*

# Allowed Hosts Configuration
ALLOWED_HOSTS=localhost,127.0.0.1

# Infrastructure Configuration
PORT=3201
REPO_OWNER=YOUR_REPO_OWNER
REPO_NAME=YOUR_REPO_NAME
BRANCH=YOUR_BRANCH
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Private API IP Restriction (opt-in, comma-separated)
# When set, only listed IPs can access private port (metrics/health).
# When unset, all IPs are allowed (default behavior).
# PRIVATE_API_ALLOWED_IPS=127.0.0.1,172.17.0.1
