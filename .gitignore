# ==============================================================================
# MultiversX Assets Service - Git Ignore Configuration
# ==============================================================================
# DO NOT PUSH TO GITHUB (Ignored below):
# - Secrets and environment variables (.env, .env.*)
# - Agentic and assistant tooling artifacts (.agent/, .gemini/, .gsd/, etc.)
# - Local runtime logs (*.log, api.log)
# - Compiled artifacts and dependencies (/dist, /node_modules)
# - Temporary test outputs and coverage reports
#
# CAN PUSH TO GITHUB (Tracked by Git):
# - Application source code (/apps, /libs)
# - Configuration schemas and templates
# - Dockerfiles and deployment configurations (/deploy, docker-compose.yml)
# - Unit and regression test suites (/test)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: NEVER PUSH TO GITHUB)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ------------------------------------------------------------------------------
# 2. Dependencies & Compiled Output
# ------------------------------------------------------------------------------
/dist
/node_modules
build.yaml

# ------------------------------------------------------------------------------
# 3. Logs & Runtime Diagnostic Files
# ------------------------------------------------------------------------------
logs
*.log
api.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Agentic AI & Workspace Assistant Tooling (Internal Only)
# ------------------------------------------------------------------------------
.agent/
.agents/
.gemini/
.gsd/
GSD-STYLE.md
PROJECT_RULES.md
VERSION
model_capabilities.yaml
skills-lock.json
adapters/
scripts/

# ------------------------------------------------------------------------------
# 5. Tests & Coverage Artifacts
# ------------------------------------------------------------------------------
/coverage
/.nyc_output
test/performance/load-results.json

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 7. Auto-generated App Config Copies (Copied from root /config by npm scripts)
# ------------------------------------------------------------------------------
apps/*/config/
**/*/config/config.custom.yaml
**/*/config/schema.json
**/*/config/config.yaml
**/*/config/schema.yaml
!config/config.yaml
!config/schema.yaml

